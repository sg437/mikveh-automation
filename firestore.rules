rules_version = '2';

// המסד סגור לגמרי לגישה מהדפדפן ומהאפליקציה.
// רק השרת (ה-Apps Script, עם חשבון שירות) קורא וכותב — וחשבון שירות עוקף
// את הכללים האלה. כך שום מפתח ציבורי שב-app/config.js אינו פותח את הנתונים.
// לפני שפותחים כאן קריאה כלשהי: לוודא שהיא מותנית בכניסה ובהרשאה.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
